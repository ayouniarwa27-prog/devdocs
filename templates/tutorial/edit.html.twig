{% extends 'base.html.twig' %}

{% block title %}Modifier - DevDocs{% endblock %}

{% block body %}
    <h2 class="mb-4">Modifier le tutoriel</h2>

    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.category) }}
        {{ form_row(form.tags) }}
        {{ form_row(form.content) }}
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}