<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden;">
    <div style="background-color: #198754; color: #ffffff; padding: 20px; text-align: center;">
        <h1 style="margin: 0;">Nouveau tutoriel publié</h1>
    </div>
    <div style="padding: 20px; color: #212529;">
        <p>Bonjour administrateur,</p>
        <p>Un nouveau tutoriel vient d'être mis en ligne :</p>
        <table style="width: 100%; border-collapse: collapse;">
            <tr><td style="padding: 8px; border-bottom: 1px solid #dee2e6;"><strong>Titre</strong></td><td style="padding: 8px; border-bottom: 1px solid #dee2e6;">{{ tutorial.title }}</td></tr>
            <tr><td style="padding: 8px; border-bottom: 1px solid #dee2e6;"><strong>Auteur</strong></td><td style="padding: 8px; border-bottom: 1px solid #dee2e6;">{{ tutorial.author.pseudonyme }}</td></tr>
            <tr><td style="padding: 8px; border-bottom: 1px solid #dee2e6;"><strong>Catégorie</strong></td><td style="padding: 8px; border-bottom: 1px solid #dee2e6;">{{ tutorial.category.name }}</td></tr>
            <tr><td style="padding: 8px;"><strong>Date</strong></td><td style="padding: 8px;">{{ tutorial.createdAt|date('d/m/Y à H:i') }}</td></tr>
        </table>
        <p style="text-align: center; margin: 30px 0;">
            <a href="{{ url('app_tutorial_show', {slug: tutorial.slug}) }}" style="background-color: #198754; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 5px;">Voir le tutoriel</a>
        </p>
    </div>
</div>