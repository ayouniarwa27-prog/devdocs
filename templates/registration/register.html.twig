{% extends 'base.html.twig' %}

{% block title %}Inscription - DevDocs{% endblock %}

{% block body %}
    <h2 class="mb-4">Créer un compte</h2>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email, {label: 'Adresse e-mail'}) }}
        {{ form_row(registrationForm.pseudonyme, {label: 'Pseudonyme'}) }}
        {{ form_row(registrationForm.plainPassword, {label: 'Mot de passe'}) }}
        {{ form_row(registrationForm.agreeTerms, {label: "J'accepte les conditions d'utilisation"}) }}

        <button type="submit" class="btn btn-primary">S'inscrire</button>
    {{ form_end(registrationForm) }}

    <p class="mt-3">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
{% endblock %}